// Übergangswahrscheinlichkeiten
m = [
	0 0.2 0.8,
	0.5 0 0.5,
	0.1 0.9 0
];

// Ausgangszustand
heute = [1 0 0];

// Anzahl Tage für Vorhersage
Tage = 10;

for (i = 1, i <= Tage, i = i + 1,
	vorhersage = heute * m;
	write(
		"Tag ", i, ": ",
		"Sonnig: ", Round(vorhersage[1], 2)*100, "%\!t",
		"Bewölkt: ", Round(vorhersage[2], 2)*100, "%\!t, ",
		"Regen: ", Round(vorhersage[3], 2)*100, "%", "\!n"
	);
	heute = vorhersage;
);

